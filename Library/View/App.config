<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="BasicHttpBinding_IWebServiceLibrary">
					<security mode="Transport" />
				</binding>
			</basicHttpBinding>
		</bindings>

		<client>
			<endpoint
			  address="https://localhost:44384/WebServiceLibrary.asmx"
			  binding="basicHttpBinding"
			  bindingConfiguration="BasicHttpBinding_IWebServiceLibrary"
			  contract="ServiceReferenceLibrary.WebServiceLibrarySoap"
			  name="WebServiceLibrarySoap" />
		</client>
	</system.serviceModel>
</configuration>
